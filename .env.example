# Set these in Vercel Project Settings > Environment Variables.
# Never commit the real values.
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Production only. Use a fine-grained token limited to this repository with
# Repository permissions > Contents: Read and write.
GITHUB_CONTENT_TOKEN=replace-with-a-fine-grained-github-token
GITHUB_REPOSITORY=letsgogreen/legitbodyfix
GITHUB_BRANCH=main

# Buyer library (Supabase). The publishable key is used only by library.html;
# the secret key stays in Vercel server functions and must never be exposed.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-publishable-key
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-server-only-secret-key

# PayPal Checkout. Create a PayPal Developer app and use sandbox credentials
# for Preview testing. Use live credentials only in Production.
# The client ID is safe to expose to checkout.html. The secret and webhook ID
# are server-only and must never be committed or added to browser code.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace-with-your-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-your-paypal-client-secret
PAYPAL_WEBHOOK_ID=replace-with-your-paypal-webhook-id

# Stripe hosted card checkout. Start with sk_test_ credentials in Preview.
# Both values are server-only and must never appear in browser code.
STRIPE_SECRET_KEY=sk_test_replace-with-your-stripe-test-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-stripe-webhook-signing-secret

# Protected video playback and uploads (Cloudflare Stream). These are server-only
# values. The admin creates a one-time direct upload link and saves the Stream ID
# only after upload; the API token is never sent to a browser.
# The Stream token needs Account > Stream > Edit permission.
CLOUDFLARE_STREAM_ACCOUNT_ID=replace-with-your-cloudflare-account-id
CLOUDFLARE_STREAM_API_TOKEN=replace-with-a-server-only-stream-api-token
CLOUDFLARE_STREAM_CUSTOMER_CODE=replace-with-your-stream-customer-code
CLOUDFLARE_STREAM_TOKEN_TTL_SECONDS=900
